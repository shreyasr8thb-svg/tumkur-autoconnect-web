# Normalize line endings to LF on all platforms
* text=auto eol=lf

# Force LF for web files
*.ts   eol=lf
*.tsx  eol=lf
*.js   eol=lf
*.jsx  eol=lf
*.css  eol=lf
*.json eol=lf
*.md   eol=lf
*.yml  eol=lf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
